{
  "name": "panindigan-messenger-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Panindigan Messenger Bot — modular Messenger automation service.",
  "license": "LICENSED",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "migrate": "tsx scripts/migrate.ts",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "verify:commands": "tsx scripts/verify-commands.ts"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "dotenv": "18.0.10",
    "fastify": "5.12.8",
    "mongodb": "7.9.1",
    "nodemailer": "10.6.1",
    "pino": "10.4.0",
    "pino-pretty": "13.2.0",
    "pg": "8.23.1",
    "panindigan-automate": "0.3.5",
    "redis": "6.3.1",
    "ws": "8.18.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "@typescript/native": "npm:typescript@7.0.2",
    "@types/pg": "8.23.1",
    "@types/ws": "8.18.1",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
