{
  "name": "nazzel-messenger-userbot",
  "version": "2.13.0",
  "description": "Advanced Facebook Messenger User-Bot with TypeScript, PostgreSQL, and comprehensive logging",
  "main": "dist/main.js",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "start": "node --max-old-space-size=4096 dist/main.js",
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "lint": "eslint src/",
    "format": "prettier --write src/"
  },
  "keywords": [
    "messenger",
    "userbot",
    "facebook",
    "typescript",
    "chatbot",
    "postgresql"
  ],
  "author": "Nazzel",
  "license": "SEE LICENSE IN LICENSE.md",
  "dependencies": {
    "@distube/ytdl-core": "^4.16.12",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@spotify/web-api-ts-sdk": "^1.2.0",
    "@tensorflow/tfjs": "^4.22.0",
    "archiver": "^7.0.1",
    "axios": "^1.21.1",
    "chalk": "^5.6.2",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "file-type": "^22.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "jimp": "^1.6.1",
    "node-cache": "^5.1.2",
    "node-fetch": "^3.3.2",
    "nsfwjs": "^4.4.0",
    "openai": "^4.104.0",
    "panindigan-automate": "^0.2.4",
    "pg": "^8.23.1",
    "undici": "^8.12.4",
    "unzipper": "^0.12.5",
    "uuid": "^11.1.1",
    "winston": "^3.19.0",
    "yt-search": "^2.13.1",
    "ytdl-core": "^4.11.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "."
  ],
  "overrides": {
    "buffer": "6.0.3",
    "tough-cookie": "^6.1.0"
  }
}
