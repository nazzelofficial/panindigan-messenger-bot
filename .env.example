# Copy to .env and fill in locally. Never commit .env.
NODE_ENV=production

# Messenger — Facebook AppState only. The value is the JSON exported from a
# logged-in browser session. There is no email/password login.
FB_APPSTATE=

# Local Docker database passwords (used by docker-compose.yml only)
POSTGRES_PASSWORD=
MONGODB_PASSWORD=
REDIS_PASSWORD=

# Databases
POSTGRES_DATABASE_URL=
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
MONGODB_URI=
REDIS_URL=

# Publisher and optional web services
PANINDIGAN_CONTACT_EMAIL=
DASHBOARD_SESSION_SECRET=
UPTIME_SOCKET_TOKEN=
UPTIME_TARGET_URL=

# Alert channels
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
TELEGRAM_BOT_TOKEN=
DISCORD_ALERT_WEBHOOK_URL=

# Messenger proxy (optional)
MESSENGER_PROXY_URL=

# AI provider (OpenAI-compatible chat-completions endpoint)
AI_PROVIDER_API_KEY=
AI_PROVIDER_BASE_URL=
AI_PROVIDER_DEFAULT_MODEL=
AI_PROVIDER_FALLBACK_MODEL=
